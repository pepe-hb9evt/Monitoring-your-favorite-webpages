# Ignore everything (/*) except the project files (allow-list with !/... ).
# This keeps the real site list (websites.json, possibly with credentials), settings.json,
# the report and the per-site data folders (copies, archive) out of Git.

# Ignore everything ...
/*

# .. except this wihte list:
!/.gitignore
!/LICENSE
!/README.md
!/README_deutsch_german.md
!/DOCUMENTATION.md
!/DOCUMENTATION_deutsch_german.md
!/requirements.txt
!/website_monitor.py
!/websites.example.json
!/settings.example.json

# Python
__pycache__/
*.pyc
