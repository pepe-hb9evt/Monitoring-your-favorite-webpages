# Ignore everything (/*) except the project files (allow-list with !/... ).
# This keeps the real site list (webpages.json, possibly with credentials), settings.json,
# secrets.json (SMTP password), the report and the per-site data folders (copies, archive) out of Git.

# Ignore everything ...
/*

# .. except this wihte list:
!/.gitignore
!/LICENSE
!/README.md
!/README_deutsch_german.md
!/DOCUMENTATION.md
!/DOCUMENTATION_deutsch_german.md
!/requirements.txt
!/webpages_monitor.py
!/webpages.example.json
!/settings.example.json
!/secrets.example.json
!/install_task.ps1

# Python
__pycache__/
*.pyc
